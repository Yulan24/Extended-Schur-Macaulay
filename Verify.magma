load"Math.magma";

function pstmat(n1,n2,F,d1,d2)
    p:=Characteristic(F);
    k:=0;
    nclu:=0;
    Clu:=AssociativeArray();
	for x in ctb(n1,p-1,d1) do 
        for y in ctb(n2,p-1,d2) do
            nclu:=nclu+1; 
            Clu[idx(x cat y,p)]:=nclu;
        end for;
    end for;
    M:=ZeroMatrix(F,0,nclu);
    while p^k le d2 do
        for x in ctb(n1,p-1,d1+p^k) do 
            for y in ctb(n2,p-1,d2-p^k) do
                N:=ZeroMatrix(F,1,nclu);
                for z in ctb(n2,[x[i]:i in [1..n2]],p^k) do
                    A:=[i le n2 select x[i]-z[i] else x[i]:i in [1..n1]];
                    B:=[y[i]+z[i]:i in [1..n2]];
                    if Max(B) le p-1 and F!&*[Binomial(x[i],z[i]):i in [1..n2]] ne 0 then
                        N[1,Clu[idx(A cat B,p)]]:=F!&*[Binomial(x[i],z[i]):i in [1..n2]];
                    end if;
                end for;
                M:=VerticalJoin(M,N);
            end for;
        end for;
        k:=k+1;
    end while;
    return M;
end function;

function sthil(G,n2,d1,d2,r)
    P:=Parent(G[1]);
    F:=BaseRing(P);
    p:=Characteristic(F);
    n1:=Rank(P);
    R:=PolynomialRing(F,n1+n2);
    E:=[R.i:i in [1..n1]];
    G:=[Evaluate(f,E):f in G];
    G:=[R!gamgen(f,p^e):e in [0..r],f in G];
    M:=pstmat(n1,n2,F,d1,d2);
	nclu:=0;
	Clu:=AssociativeArray();
	for x in ctb(n1,p-1,d1) do
		for y in ctb(n2,p-1,d2) do
			nclu:=nclu+1;
			Clu[idx(x cat y,p)]:=nclu;
		end for;
	end for;
    for f in G do
        M:=VerticalJoin(M,twocefmat(f,Clu,n1,d1,d2));
    end for;
    return nclu-Rank(M);
end function;

procedure stver(n,v,m,k1,k2,q,r)
    o:=n-v;
    p:=PrimeDivisors(q)[1];
    G:=uovpk(n,v,m,k1,q)[1];
    for i in [1..Min((o-k1)*(p-1),3)] do
        for j in [1..Min((o-k2)*(p-1),i)] do
            print [i,j,sthil(G,n-k2,i,j,r),Sto(n-k1,n-k2,m,p,r,i,j)];
        end for;
    end for; 
end procedure;
