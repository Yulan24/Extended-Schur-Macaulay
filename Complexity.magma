load"Math.magma";
load"Oddcplx.magma";

procedure mayo(n,m,o)
    row:=[<"Attack","Level: r","Oil minus: [k1,k2]","Solving degree: [d1,d2]","Complexity: C">];
    for r in [0..2] do
        Q:=schtwocplx(n,n-o,m,16,r);
        if Q[5] ne 1000 then
            Append(~row,<"Schur",Sprint(r),Sprint([Q[1],Q[2]]),Sprint([Q[3],Q[4]]),Sprint(Q[5])>);
        else
            Append(~row,<"Schur",Sprint(r),"-","-","-">);
        end if;
    end for;
    Append(~row,<"Attack","Level: r","Oil minus: k","Solving degree: d","Complexity: C">);
    for r in [0..2] do
        Q:=onecplx(n,n-o,m,16,r);
        if Q[4] ne 1000 then
            Append(~row,<"Divided",Sprint(r),Sprint(Q[1]),Sprint(Q[2]),Sprint(Q[4])>);
        else
            Append(~row,<"Divided",Sprint(r),"-","-","-">);
        end if;
    end for;
    maketable(row);
end procedure;
